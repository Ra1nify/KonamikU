<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- In-app update: install the downloaded APK via PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.nfc" android:required="true" />
    <uses-feature android:name="android.hardware.nfc.hcef" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Konamiku"
        android:name=".KonamikuApp"
        android:description="@string/mod_desc"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection|screenLayout"
            android:theme="@style/Theme.Konamiku.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <service
            android:name=".nfc.EmuCard"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_NFCF_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_nfcf_service"
                android:resource="@xml/hce_f_service" />
        </service>

        <service
            android:name=".nfc.DummyPaymentService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>

        <receiver
            android:name=".notification.ScanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.cf0x.konamiku.ACTION_SCAN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.cf0x.konamiku.ACTION_TOGGLE_ACTIVATE" />
                <action android:name="org.cf0x.konamiku.ACTION_TOGGLE_MODE" />
                <action android:name="org.cf0x.konamiku.ACTION_NEXT_CARD" />
                <action android:name="org.cf0x.konamiku.ACTION_NOTIF_DISMISSED" />
            </intent-filter>
        </receiver>

        <!-- Receives broadcast from com.android.nfc process confirming hook is live -->
        <receiver
            android:name=".xposed.NfcHookReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.cf0x.konamiku.ACTION_NFC_HOOKED" />
            </intent-filter>
        </receiver>

        <!-- Foreground download + install of the update APK -->
        <service
            android:name=".system.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives the PackageInstaller commit result -->
        <receiver
            android:name=".system.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.cf0x.konamiku.ACTION_INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="101" />

        <!-- QS tile disabled -->
        <!--
        <service
            android:name=".system.KonamikuTileService"
            android:icon="@drawable/ic_nfc"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        -->

        <!-- Cross-process config provider for Xposed module (reads PMm enabled state) -->
        <provider
            android:name=".system.PmmConfigProvider"
            android:authorities="org.cf0x.konamiku.pmmconfig"
            android:exported="true" />

    </application>

</manifest>